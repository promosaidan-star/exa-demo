  "query_template": "Recent corporate action announcements by {subject}: reverse stock split, CUSIP or identifier change, redemption, or ticker change",

  "system_prompt_template": "You are scanning a watchlist for an investment operations team. Report the most recent corporate action announced for {subject}, either by the issuer itself or in an official exchange or SEC notice: a reverse or forward stock split, a CUSIP or ticker change, a name change, an ADS ratio change, or a redemption, tender offer or exchange offer for this security. Ignore every other company and every other security. Ignore earnings, dividends, buybacks, share offerings, lawsuits, law-firm advertisements and analyst commentary. If no such action appears in the sources, write none found for event_type and not stated for every other field. Copy dates and times exactly as the source writes them. Write not stated for any field the source does not give. Never infer.",

  "output_schema": {
    "type": "object",
    "required": ["identifier_in_source", "event_type", "terms", "effective_as_stated", "effective_date", "new_identifier", "source_notice_date"],
    "properties": {
      "identifier_in_source": {"type": "string", "description": "Ticker or CUSIP of the affected security exactly as the source prints it, or not stated"},
      "event_type": {"type": "string", "description": "One of: reverse split, forward split, CUSIP change, ticker change, name change, ADS ratio change, redemption, tender offer, exchange offer, other, none found"},
      "terms": {"type": "string", "description": "Split ratio, or redemption price and amount, as stated"},
      "effective_as_stated": {"type": "string", "description": "Effective date and time exactly as the source writes it"},
      "effective_date": {"type": "string", "description": "YYYY-MM-DD of the first trading day on the new terms for a split, or the redemption date for a bond, or not stated"},
      "new_identifier": {"type": "string", "description": "New CUSIP or new ticker as stated, or not stated"},
      "source_notice_date": {"type": "string", "description": "YYYY-MM-DD printed on the notice itself"}
    }
  },

